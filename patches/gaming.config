# =============================================================================
# Gaming performance defconfig fragment for Motorola Edge 30 (dubai, SM7325)
# Applied on top of lahaina-qgki_defconfig during build.
# =============================================================================

# --- OBRIGATORIO: Motorola DT precisa de overlay habilitado ---
# Sem isso o build falha em arch/arm64/boot/dts/vendor/qcom/Makefile:
#   "Moto DT w/o overlay is undefined!!!"
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# --- Networking: latencia + throughput ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# --- Timers de alta resolucao ---
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_300=y
CONFIG_HZ=300

# --- Scheduler / autogroup ---
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y

# --- Preempcao para menor latencia touch/frame ---
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RCU=y

# --- ZRAM com LZ4 (mais rapido que zstd em swap ativo) ---
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# --- IO schedulers otimizados para NVMe/UFS ---
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# --- CPU governor default: schedutil (bom equilibrio) ---
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# --- LTO (link-time optimization) se suportado ---
# CONFIG_LTO_CLANG=y

# --- Reduzir overhead de tracing/debug em build de release ---
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_INFO is not set
